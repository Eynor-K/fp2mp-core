data/normative/
overlief/

# Benchmark caches — generated by examples/benchmark_fp2mp.ipynb.
# Only the input tasks (problems.json) live in the repo; all solutions
# and judge outputs are regenerated on a real benchmark run.
data/benchmark/solutions.json
data/benchmark/evaluations_fp2mp.json
data/benchmark/bench_solutions.json
data/benchmark/bench_evaluations.json
examples/data/

# === Claude Code ===
.claude/

# === Runtime artifacts ===
# Wiki pages persisted to disk (WIKI_PERSIST_DIR)
wiki_output/
wiki_persist/
cache/

# Run logs produced by the test runner / manual runs
tests/logs/

# Stray wiki page files that land in project root
*.meta.json

# Wikiscribe output — never commit generated wiki pages
wiki_pages/
wiki_dump/
wiki_scribe_out/

# === LangChain / LangGraph cache ===
.langchain.db

# === Local run artifacts (examples/) ===
# Caches produced by Tavily / DDGS / web fetches
examples/cache/
examples/**/cache/

# Ablation smoke-test outputs (regenerated by examples/ablation/run_ablation.py)
examples/ablation/runs/

# Baseline masterplan outputs (regenerated by examples/baseline_masterplan.py)
examples/baseline/*/

# === Build artifact directories left in source tree ===
# (in-tree *.egg-info/ — should never be committed even though gitignore above covers it)